#!/usr/bin/env sh
set -eu

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
systemctl --user disable --now post-once-run-due.timer 2>/dev/null || true
rm -f "$UNIT_DIR/post-once-run-due.timer" "$UNIT_DIR/post-once-run-due.service"
systemctl --user daemon-reload

echo "Removed the post-once user timer. Existing schedule and publication history were left intact."
