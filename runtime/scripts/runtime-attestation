#!/usr/bin/env sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/scripts/runtime-env"
PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
  exec python3 -c 'import json; from ocpf_post.runtime_attestation import attest; print(json.dumps(attest(), indent=2))'
