#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/scripts/runtime-env"
case "$ROOT" in
  *" "*)
    echo "Refusing install because the repository path contains spaces: $ROOT" >&2
    exit 2
    ;;
esac

# Keep publisher and refill services on the same local checkout.
sh "$ROOT/scripts/install-user-scheduler-timer"

CONFIG_ROOT="$POST_ONCE_CONFIG_DIR"
STATE_ROOT="$POST_ONCE_STATE_DIR"
mkdir -p "$CONFIG_ROOT" "$STATE_ROOT"
chmod 700 "$CONFIG_ROOT" "$STATE_ROOT" 2>/dev/null || true

UNIT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
mkdir -p "$UNIT_DIR"

cat > "$UNIT_DIR/post-once-portfolio-refill.service" <<EOF
[Unit]
Description=Refill rolling post-once portfolio GTM reservations
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=$ROOT
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=POST_ONCE_CONFIG_DIR=$CONFIG_ROOT
Environment=POST_ONCE_STATE_DIR=$STATE_ROOT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=$CONFIG_ROOT $STATE_ROOT
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ExecStart=/bin/sh $ROOT/scripts/run-unattended refill
EOF

cat > "$UNIT_DIR/post-once-portfolio-refill.timer" <<'EOF'
[Unit]
Description=Re-evaluate the portfolio GTM queue every 15 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=15min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
EOF

cat > "$UNIT_DIR/post-once-collection.service" <<EOF
[Unit]
Description=Observe source and vault changes independently of publishing capacity
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=$ROOT
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=POST_ONCE_CONFIG_DIR=$CONFIG_ROOT
Environment=POST_ONCE_STATE_DIR=$STATE_ROOT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=$CONFIG_ROOT $STATE_ROOT
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ExecStart=/bin/sh $ROOT/scripts/run-unattended collect
TimeoutStartSec=12min
EOF

cat > "$UNIT_DIR/post-once-collection.timer" <<'EOF'
[Unit]
Description=Collect bounded source, vault and engagement observations every 15 minutes

[Timer]
OnBootSec=1min
OnUnitActiveSec=15min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
EOF
chmod 600 "$UNIT_DIR/post-once-collection.service" "$UNIT_DIR/post-once-collection.timer"

chmod 600 "$UNIT_DIR/post-once-portfolio-refill.service" "$UNIT_DIR/post-once-portfolio-refill.timer"
cat > "$UNIT_DIR/post-once-replies.service" <<EOF
[Unit]
Description=Process authorised post-once conversation responses
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=$ROOT
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=POST_ONCE_CONFIG_DIR=$CONFIG_ROOT
Environment=POST_ONCE_STATE_DIR=$STATE_ROOT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=$CONFIG_ROOT $STATE_ROOT
RestrictSUIDSGID=true
LockPersonality=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ExecStart=/bin/sh $ROOT/scripts/run-unattended respond
TimeoutStartSec=6min
EOF

cat > "$UNIT_DIR/post-once-replies.timer" <<'EOF'
[Unit]
Description=Review pending conversations and process authorised replies every 15 minutes

[Timer]
OnBootSec=4min
OnUnitActiveSec=15min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
EOF
chmod 600 "$UNIT_DIR/post-once-replies.service" "$UNIT_DIR/post-once-replies.timer"

systemctl --user daemon-reload
if [ "${OCPF_POST_STAGE_ONLY:-0}" = "1" ]; then
  :
elif [ "${OCPF_POST_DEFER_TIMER_START:-0}" = "1" ]; then
  systemctl --user enable post-once-portfolio-refill.timer post-once-collection.timer post-once-replies.timer
else
  systemctl --user enable --now post-once-portfolio-refill.timer post-once-collection.timer post-once-replies.timer
fi
systemctl --user status --no-pager post-once-portfolio-refill.timer || true

echo "Installed local portfolio allocator. It uses this checkout and never updates repository code itself."
