#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/scripts/runtime-env"
cd "$ROOT"

# This is a local-PC runtime. A refill must never update application code.
# Refuse tracked work-in-progress so a timer does not execute a half-edited
# checkout, but do not reject harmless untracked operator artefacts.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Refusing portfolio refill because the post-once checkout has tracked local changes." >&2
  exit 3
fi

# Collector and reporter failures cannot prevent local allocation. Source/vault
# observation has its own timer; refill consumes saved evidence only.
observe_queue_exit() {
  "$ROOT/scripts/run-operating-cycle" report || true
  # One bounded post-refill side task maintains local request continuity first,
  # then performs the existing opt-in private handoff. Neither result can change
  # the allocator exit status or create publication authority.
  timeout 140s sh -c '
    python3 "$1/scripts/editorial-continuity.py" --apply || true
    python3 "$1/scripts/editorial-handoff.py" --apply || true
  ' sh "$ROOT" || true
}
trap observe_queue_exit EXIT

./post-once portfolio experiment reconcile --apply || true
./post-once replenish refresh --apply || true
./post-once replenish reconcile
./post-once portfolio reconcile
./post-once portfolio refill --apply --horizon-minutes "${OCPF_POST_PORTFOLIO_HORIZON_MINUTES:-75}"
