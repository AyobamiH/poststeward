#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
. "$ROOT/scripts/runtime-env"
cd "$ROOT"

# This is a local-PC runtime. A refill must never update application code.
# Refuse tracked work-in-progress so a timer does not execute a half-edited
# checkout, but do not reject harmless untracked operator artefacts.
if ! git diff --quiet || ! git diff --cached --quiet; then
  echo "Refusing portfolio refill because the poststeward checkout has tracked local changes." >&2
  exit 3
fi

# One desired-state controller owns the safe supply path:
# sense exact account deficits -> refresh blocked vault/source evidence -> admit
# already-authorised inventory -> reconcile -> reserve -> re-sense.
# It never runs run-due or a provider publication command.
./poststeward portfolio experiment reconcile --apply || true

controller_status=0
python3 "$ROOT/scripts/reconcile-rolling-supply.py" \
  --apply \
  --horizon-minutes "${OCPF_POST_PORTFOLIO_HORIZON_MINUTES:-75}" \
  --max-passes "${OCPF_POST_ROLLING_SUPPLY_MAX_PASSES:-1}" \
  || controller_status=$?

# Work/Docs remains the normal authoring plane for genuine generation deficits.
# This handoff may report demand; it does not publish, raise quota or enable the
# paid local API author.
timeout 140s python3 "$ROOT/scripts/editorial-handoff.py" --apply || true

# Refresh compact acceptance from the evidence the controller just changed.
PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" \
  python3 -m ocpf_post.acceptance_views --apply >/dev/null 2>&1 || true

"$ROOT/scripts/run-operating-cycle" report || true

exit "$controller_status"
