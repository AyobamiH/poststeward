#!/usr/bin/env sh
# Source this file from standalone Post-Once runtime scripts.
# Historical OCPF_POST_* path variables are intentionally overwritten so this
# lineage cannot inherit the owner's original Post-Once state/config/service roots.

POST_ONCE_CONFIG_DIR="${POST_ONCE_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/post-once}"
POST_ONCE_STATE_DIR="${POST_ONCE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/post-once}"
POST_ONCE_RELEASES_DIR="${POST_ONCE_RELEASES_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/post-once/releases}"
POST_ONCE_SETUP_STATE_DIR="${POST_ONCE_SETUP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/post-once-bootstrap/setup}"

export POST_ONCE_CONFIG_DIR POST_ONCE_STATE_DIR POST_ONCE_RELEASES_DIR POST_ONCE_SETUP_STATE_DIR
export OCPF_POST_CONFIG_DIR="$POST_ONCE_CONFIG_DIR"
export OCPF_POST_STATE_DIR="$POST_ONCE_STATE_DIR"
export OCPF_POST_RELEASES_DIR="$POST_ONCE_RELEASES_DIR"
export OCPF_POST_SETUP_STATE_DIR="$POST_ONCE_SETUP_STATE_DIR"
export POST_ONCE_PRODUCT_LINEAGE="post-once-bootstrap-runtime-v1"

if [ -n "${POST_ONCE_RUNTIME_ROOT:-}" ]; then
  export OCPF_POST_RUNTIME_ROOT="$POST_ONCE_RUNTIME_ROOT"
fi
