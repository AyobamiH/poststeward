#!/usr/bin/env sh
set -eu

# Canonical public PostSteward runtime namespace.
POSTSTEWARD_RUNTIME_CONFIG_DIR="${POSTSTEWARD_RUNTIME_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/poststeward/runtime}"
POSTSTEWARD_RUNTIME_STATE_DIR="${POSTSTEWARD_RUNTIME_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/poststeward/runtime}"
POSTSTEWARD_RELEASES_DIR="${POSTSTEWARD_RELEASES_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/poststeward/releases}"
POSTSTEWARD_SETUP_STATE_DIR="${POSTSTEWARD_SETUP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/poststeward/setup}"

export POSTSTEWARD_RUNTIME_CONFIG_DIR POSTSTEWARD_RUNTIME_STATE_DIR
export POSTSTEWARD_RELEASES_DIR POSTSTEWARD_SETUP_STATE_DIR
export POSTSTEWARD_RUNTIME_LINEAGE="poststeward-local-runtime-v1"

# Transitional A-K compatibility. Public callers should use POSTSTEWARD_* only.
export POST_ONCE_CONFIG_DIR="$POSTSTEWARD_RUNTIME_CONFIG_DIR"
export POST_ONCE_STATE_DIR="$POSTSTEWARD_RUNTIME_STATE_DIR"
export POST_ONCE_RELEASES_DIR="$POSTSTEWARD_RELEASES_DIR"
export POST_ONCE_SETUP_STATE_DIR="$POSTSTEWARD_SETUP_STATE_DIR"
export POST_ONCE_PRODUCT_LINEAGE="$POSTSTEWARD_RUNTIME_LINEAGE"

export OCPF_POST_CONFIG_DIR="$POSTSTEWARD_RUNTIME_CONFIG_DIR"
export OCPF_POST_STATE_DIR="$POSTSTEWARD_RUNTIME_STATE_DIR"
export OCPF_POST_RELEASES_DIR="$POSTSTEWARD_RELEASES_DIR"
export OCPF_POST_SETUP_STATE_DIR="$POSTSTEWARD_SETUP_STATE_DIR"

if [ -n "${POSTSTEWARD_RUNTIME_ROOT:-}" ]; then
  export POST_ONCE_RUNTIME_ROOT="$POSTSTEWARD_RUNTIME_ROOT"
  export OCPF_POST_RUNTIME_ROOT="$POSTSTEWARD_RUNTIME_ROOT"
fi
