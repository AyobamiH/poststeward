{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://post-once.local/schemas/setup-recovery/v1/automation-authority.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "operation_id",
    "installation_id",
    "authority_generation",
    "review_sha256",
    "runtime_revision",
    "activated_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "active",
        "inactive"
      ]
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "installation_id": {
      "type": "string",
      "format": "uuid"
    },
    "authority_generation": {
      "type": "integer",
      "minimum": 1
    },
    "review_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "deactivated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "inactive"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "deactivated_at",
          "reason"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "deactivated_at"
              ]
            },
            {
              "required": [
                "reason"
              ]
            }
          ]
        }
      }
    }
  ]
}
