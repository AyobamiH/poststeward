{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://post-once.local/schemas/setup-recovery/v1/operation.schema.json",
  "title": "Post-Once operation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "operator_label",
    "status",
    "authority_generation",
    "active_installation_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "operator_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "enum": [
        "prepared",
        "active",
        "recovery_review",
        "retired"
      ]
    },
    "authority_generation": {
      "type": "integer",
      "minimum": 1
    },
    "active_installation_id": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "active_installation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "else": {
        "properties": {
          "active_installation_id": {
            "type": "null"
          }
        }
      }
    }
  ]
}
