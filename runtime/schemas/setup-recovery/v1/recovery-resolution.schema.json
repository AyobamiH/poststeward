{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://post-once.local/schemas/setup-recovery/v1/recovery-resolution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "source_installation_id",
    "resolutions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation_id": {
      "type": "string",
      "format": "uuid"
    },
    "source_installation_id": {
      "type": "string",
      "format": "uuid"
    },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "method",
          "observed_at",
          "evidence_ref"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 3
          },
          "status": {
            "const": "resolved"
          },
          "method": {
            "type": "string",
            "minLength": 3
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  }
}
