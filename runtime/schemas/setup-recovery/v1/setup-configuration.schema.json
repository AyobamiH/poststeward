{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://post-once.local/schemas/setup-recovery/v1/setup-configuration.schema.json",
  "title": "Post-Once staged setup configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "timezone",
    "pace_profile",
    "daily_originals",
    "hard_ceiling",
    "publishing_authority"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "pace_profile": {
      "enum": [
        "occasional",
        "regular",
        "active",
        "high",
        "custom"
      ]
    },
    "daily_originals": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "hard_ceiling": {
      "const": 100
    },
    "publishing_authority": {
      "const": false
    }
  }
}
